<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SoftcomSmartProvisioner</AssemblyName>
    <RootNamespace>SoftcomSmartProvisioner</RootNamespace>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Version>1.0.4.1</Version>
    <AssemblyVersion>1.0.4.1</AssemblyVersion>
    <FileVersion>1.0.4.1</FileVersion>
    <Product>Softcom Smart Provisioner</Product>
    <Company>Softcom Tecnologia</Company>
    <Description>Provisionamento e preparação de dispositivos Smart para QA.</Description>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\App.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\App.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="update-defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\tools\**\*">
      <Link>tools\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <SelfHostBridgePublishDir>$(BaseIntermediateOutputPath)SelfHostBridge\$(Configuration)\</SelfHostBridgePublishDir>
  </PropertyGroup>

  <Target Name="PublishSelfHostBridge" BeforeTargets="Build;Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild
      Projects="..\SoftcomSmartProvisioner.SelfHostBridge\SoftcomSmartProvisioner.SelfHostBridge.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(MSBuildProjectDirectory)\$(SelfHostBridgePublishDir)" />
  </Target>

  <Target Name="CopySelfHostBridgeToOutput" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <SelfHostBridgeOutput Include="$(SelfHostBridgePublishDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SelfHostBridgeOutput)" DestinationFiles="@(SelfHostBridgeOutput->'$(TargetDir)SelfHostBridge\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySelfHostBridgeToPublish" AfterTargets="Publish" DependsOnTargets="PublishSelfHostBridge" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <SelfHostBridgePublishOutput Include="$(SelfHostBridgePublishDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SelfHostBridgePublishOutput)" DestinationFiles="@(SelfHostBridgePublishOutput->'$(PublishDir)SelfHostBridge\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
